# Скопируй в .env и впиши свой ключ. Файл .env в git не попадёт (см. .gitignore).

# Ключ football-data.org (бесплатный, покрывает Лигу Чемпионов, код турнира CL)
FOOTBALL_DATA_TOKEN=

# Ключ API-Football (api-sports.io), если используешь этот провайдер
API_FOOTBALL_KEY=

# Ключ The Odds API (https://the-odds-api.com, бесплатно 500 кредитов/мес) —
# для живых коэффициентов: команды odds, round/fetch --live-odds
ODDS_API_KEY=

# Telegram-бот (python -m footy bot): токен от @BotFather и, по желанию,
# список user id через запятую, кому бот отвечает (пусто — всем)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
