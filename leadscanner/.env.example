# Секреты — только в переменных окружения. Скопируйте в .env и заполните.

# Рабочий Telegram-аккаунт (my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=
# Строка сессии: python -m leadscanner login
TG_SESSION=

# Бот оператора (@BotFather)
BOT_TOKEN=
# Куда приходят карточки: id лички оператора или закрытого рабочего чата (узнать: /start в боте)
OPERATOR_CHAT_ID=
# Кто может нажимать кнопки (через запятую). Для лички можно не заполнять.
OPERATOR_IDS=

# Claude API
ANTHROPIC_API_KEY=

# База (SQLite на старте)
DB_PATH=data/leads.db

# Google Sheets (необязательно): JSON сервисного аккаунта одной строкой и id таблицы
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
